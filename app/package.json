{
  "name": "snippy",
  "displayName": "Snippy",
  "description": "Orchestrate Claude with a free local Ollama router: spawn cheap sub-model workers, keep the prompt cache warm, and see what you save.",
  "version": "0.2.0",
  "publisher": "your-publisher",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Machine Learning", "Other"],
  "keywords": ["claude", "anthropic", "ollama", "orchestrator", "router", "cost", "ai"],
  "repository": { "type": "git", "url": "https://github.com/your-publisher/snippy.git" },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "snippy", "title": "Snippy", "icon": "media/sidebar-icon.svg" }
      ]
    },
    "views": {
      "snippy": [
        { "id": "snippy.panel", "name": "Snippy", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "snippy.setApiKey", "title": "Snippy: Set API Key" },
      { "command": "snippy.clearApiKey", "title": "Snippy: Clear API Key" },
      { "command": "snippy.focus", "title": "Snippy: Open Panel" }
    ],
    "configuration": {
      "title": "Snippy",
      "properties": {
        "snippy.mainModel": {
          "type": "string",
          "default": "claude-sonnet-4-5-20250929",
          "description": "Claude model that owns the main conversation (session-fixed)."
        },
        "snippy.maxTokens": {
          "type": "number",
          "default": 1024,
          "description": "max_tokens for Claude replies."
        },
        "snippy.enablePromptCache": {
          "type": "boolean",
          "default": true,
          "description": "Mark the stable system prefix with cache_control so repeat turns bill at the cache-read rate."
        },
        "snippy.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of your local Ollama server."
        },
        "snippy.ollama.routerModel": {
          "type": "string",
          "default": "llama3.1",
          "description": "Ollama model used (for free) to route tasks. Must be pulled locally."
        },
        "snippy.priceOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-model price overrides (USD per MTok): { modelId: { inputPricePerMTok, outputPricePerMTok } }.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inputPricePerMTok": { "type": "number" },
              "outputPricePerMTok": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "pretest": "npm run compile-tests",
    "test": "node ./out-test/test/runUnit.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0"
  }
}
