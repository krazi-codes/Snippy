{
  "name": "snippy",
  "displayName": "Snippy",
  "description": "Trim the deadweight from your Claude chats and see what you save.",
  "version": "0.1.0",
  "publisher": "your-publisher",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "tokens",
    "cost",
    "chat",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-publisher/snippy.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snippy",
          "title": "Snippy",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "snippy": [
        {
          "id": "snippy.chat",
          "name": "Snippy",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "snippy.setApiKey",
        "title": "Snippy: Set API Key"
      },
      {
        "command": "snippy.clearApiKey",
        "title": "Snippy: Clear API Key"
      },
      {
        "command": "snippy.focus",
        "title": "Snippy: Open Panel"
      }
    ],
    "configuration": {
      "title": "Snippy",
      "properties": {
        "snippy.defaultModel": {
          "type": "string",
          "default": "claude-sonnet-4-5-20250929",
          "description": "Default Claude model id used for new chats and token counting."
        },
        "snippy.tokenCountDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce window (ms) before calling the token-counting API while typing."
        },
        "snippy.maxTokens": {
          "type": "number",
          "default": 1024,
          "description": "max_tokens sent to the Anthropic Messages API for replies."
        },
        "snippy.priceOverrides": {
          "type": "object",
          "default": {},
          "description": "Optional per-model price overrides. Map of modelId -> { inputPricePerMTok, outputPricePerMTok } in USD per million tokens.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inputPricePerMTok": { "type": "number" },
              "outputPricePerMTok": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "pretest": "npm run compile-tests",
    "test": "node ./out-test/test/runUnit.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0"
  }
}
