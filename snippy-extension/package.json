{
  "name": "snippy",
  "displayName": "Snippy",
  "description": "Orchestrate Claude to cut costs with intelligent routing",
  "version": "0.0.1",
  "publisher": "your-publisher",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "browser": "./out/webview/provider.js",
  "contributes": {
    "commands": [
      {
        "command": "snippy.setApiKey",
        "title": "Snippy: Set API Key"
      },
      {
        "command": "snippy.clearApiKey",
        "title": "Snippy: Clear API Key"
      },
      {
        "command": "snippy.openPanel",
        "title": "Snippy: Open Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snippy-view-container",
          "title": "Snippy",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "snippy-view-container": [
        {
          "id": "snippy-webview",
          "name": "Snippy Panel"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "snippy.openPanel",
          "when": "view == snippy-webview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Snippy",
      "properties": {
        "snippy.mainModel": {
          "type": "string",
          "default": "claude-3-5-sonnet-latest",
          "description": "Main Claude model for the session"
        },
        "snippy.maxTokens": {
          "type": "integer",
          "default": 4096,
          "description": "Maximum tokens for Claude responses"
        },
        "snippy.enablePromptCache": {
          "type": "boolean",
          "default": true,
          "description": "Enable prompt cache optimization"
        },
        "snippy.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for Ollama server"
        },
        "snippy.ollama.routerModel": {
          "type": "string",
          "default": "llama3.2:3b",
          "description": "Ollama model to use for routing"
        },
        "snippy.priceOverrides": {
          "type": "object",
          "description": "Override default Claude model pricing"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "test": "mocha ./out/test/**/*.js",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run compile-tests && npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.11.17",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.4.0",
    "nyc": "^15.1.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode": "^1.1.37"
  }
}
